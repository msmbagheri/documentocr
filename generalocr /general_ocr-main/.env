DATA_PATH='./data/images/sample/'
JSONS_PATH='./results/sample/jsons'
OUTPUT_DIR='./results/'

SAVE=True
DETECTION='lines'

TEXT_CLS_ID=0
TABLE_CLS_ID=1
PARAGRAPH_TITLE_CLS_ID=2
IMAGE_CLS_ID=3
HEADER_CLS_ID=4
FOOTER_CLS_ID=5

PADDLE_LAYOUT_MODEL_NAME='PP-DocLayout_plus-L'

# --- Surya 2.5 recognition via llama.cpp (local server) ---
SURYA_INFERENCE_BACKEND=llamacpp
SURYA_INFERENCE_URL=http://127.0.0.1:8080/v1

# --- pipeline switches (Paddle removed from the critical path) ---
ENABLE_PADDLE=false
ENABLE_RECOGNITION=true
