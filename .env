# Font paths
FONT_PATH_REGULAR=fonts/merged_reg.ttf
FONT_PATH_BOLD=fonts/merged_bold.ttf
FONT_PATH_MATH=fonts/XBNiloofar.ttf

# Page settings (A4 at 300 DPI)
PAGE_WIDTH=2480
PAGE_HEIGHT=3508
SIDE_MARGIN=200
TOP_MARGIN=200
LINE_SPACING=10
QUESTIONS_PER_PAGE=5

# Font sizes
FONT_SIZE=48
MATH_FONT_SIZE=48

# Output
OUTPUT_DIR=./output_konkour

# Choice prefixes (A, B, C, D in Persian)
CHOICE_PREFIX_1=الف)
CHOICE_PREFIX_2=ب)
CHOICE_PREFIX_3=ج)
CHOICE_PREFIX_4=د)

# Header
DEFAULT_HEADER_TEXT=آزمون سراسری

# Rendering
IMAGE_RESCALE_FACTOR=1.0
BBOX_MARGIN_X=5
BBOX_MARGIN_Y=5
QUESTION_TITLE_INDENTATION=200
